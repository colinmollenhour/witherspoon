  "phases": [
    {
      "id": "stage",
      "title": "Two machines, one Wi-Fi",
      "ms": 3000,
      "narration": "The server on the laptop said `Serving HTTP on 0.0.0.0 port 8000` — it listens at every door the laptop has, loopback included. The phone has its own doors, with nothing behind them.",
      "actions": []
    },
    {
      "id": "laptop-asks",
      "title": "The laptop asks localhost",
      "ms": 2600,
      "narration": "`localhost` is not a shared name — it means the machine that is asking. Here, that is the laptop. The request loops back inside and never touches the Wi-Fi.",
      "actions": [
        {
          "state": {
            "el": "lap-browser",
            "value": "active"
          }
        },
        {
          "show": "lap-resolve"
        },
        {
          "show": "packet"
        },
        {
          "move": {
            "el": "packet",
            "path": [
              [
                100,
                134
              ],
              [
                100,
                182
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "laptop-answered",
      "title": "The log names the asker",
      "ms": 2400,
      "narration": "A server is behind the laptop's `:8000` door, so the page comes back — and a line lands in the access log. The first field names the asker: `127.0.0.1`. The laptop asked itself.",
      "actions": [
        {
          "hide": "packet"
        },
        {
          "jump": {
            "el": "resp",
            "to": [
              100,
              182
            ]
          }
        },
        {
          "show": "resp"
        },
        {
          "move": {
            "el": "resp",
            "path": [
              [
                100,
                182
              ],
              [
                100,
                134
              ]
            ]
          }
        },
        {
          "show": "lap-status"
        },
        {
          "show": "log1"
        }
      ]
    },
    {
      "id": "phone-asks",
      "title": "The phone asks the same letters",
      "ms": 2600,
      "narration": "`localhost` still means the machine that is asking — and now that is the phone. The request loops back inside the *phone*, hunting for a server on the phone's own port `8000`.",
      "actions": [
        {
          "hide": "resp"
        },
        {
          "state": {
            "el": "lap-browser",
            "value": ""
          }
        },
        {
          "hide": "lap-resolve"
        },
        {
          "state": {
            "el": "ph-browser",
            "value": "active"
          }
        },
        {
          "show": "ph-resolve"
        },
        {
          "state": {
            "el": "packet",
            "value": ""
          }
        },
        {
          "jump": {
            "el": "packet",
            "to": [
              660,
              202
            ]
          }
        },
        {
          "show": "packet"
        },
        {
          "move": {
            "el": "packet",
            "path": [
              [
                660,
                202
              ],
              [
                660,
                276
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "nothing-there",
      "title": "Silence is the evidence",
      "ms": 2400,
      "narration": "Nothing on the phone serves the site, so the request dies where it was born. Look at the laptop's log: no new line. The laptop was never asked.",
      "actions": [
        {
          "state": {
            "el": "packet",
            "value": "bad"
          }
        },
        {
          "show": "ph-refused"
        },
        {
          "show": "ph-status"
        },
        {
          "state": {
            "el": "ph-status",
            "value": "bad"
          }
        },
        {
          "show": "log-ghost"
        },
        {
          "state": {
            "el": "lan",
            "value": "dim"
          }
        }
      ]
    },
    {
      "id": "third-address",
      "title": "The phone types the third address",
      "ms": 3000,
      "narration": "`192.168.1.42` is not a name for \"me\"; it is a place on the network. The request leaves the phone, crosses the Wi-Fi, and knocks at a door `0.0.0.0` had already opened.",
      "actions": [
        {
          "hide": "ph-refused"
        },
        {
          "hide": "ph-status"
        },
        {
          "hide": "log-ghost"
        },
        {
          "state": {
            "el": "lan",
            "value": "active"
          }
        },
        {
          "text": {
            "el": "ph-url",
            "value": "http://192.168.1.42:8000"
          }
        },
        {
          "text": {
            "el": "ph-resolve",
            "value": "192.168.1.42 — a place, not a name"
          }
        },
        {
          "state": {
            "el": "packet",
            "value": ""
          }
        },
        {
          "jump": {
            "el": "packet",
            "to": [
              660,
              202
            ]
          }
        },
        {
          "move": {
            "el": "packet",
            "path": [
              [
                660,
                202
              ],
              [
                608,
                250
              ],
              [
                558,
                288
              ],
              [
                398,
                288
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "proof",
      "title": "Proof in the first field",
      "ms": 3000,
      "narration": "The page loads, and a new log line appears. Its first field is `192.168.1.66` — the phone. Two lines, two different first fields, two different askers. That field is the proof the second device arrived.",
      "actions": [
        {
          "hide": "packet"
        },
        {
          "jump": {
            "el": "resp",
            "to": [
              352,
              288
            ]
          }
        },
        {
          "show": "resp"
        },
        {
          "move": {
            "el": "resp",
            "path": [
              [
                352,
                288
              ],
              [
                558,
                288
              ],
              [
                608,
                250
              ],
              [
                660,
                197
              ]
            ]
          }
        },
        {
          "show": "log2"
        },
        {
          "show": "ph-status"
        },
        {
          "text": {
            "el": "ph-status",
            "value": "your page"
          }
        },
        {
          "state": {
            "el": "ph-status",
            "value": "ok"
          }
        },
        {
          "state": {
            "el": "ph-browser",
            "value": "ok"
          }
        }
      ]
    },
    {
      "id": "firewall",
      "title": "When a firewall eats the packet",
      "ms": 3000,
      "narration": "If the right address still fails, watch the log. A firewall can drop the request at the laptop's edge: the bind is `0.0.0.0`, the address is right, and still no line appears. The request stopped before the server ever saw it.",
      "actions": [
        {
          "hide": "resp"
        },
        {
          "show": "fw"
        },
        {
          "show": "fw-label"
        },
        {
          "state": {
            "el": "lan",
            "value": ""
          }
        },
        {
          "state": {
            "el": "packet",
            "value": "warn"
          }
        },
        {
          "jump": {
            "el": "packet",
            "to": [
              660,
              202
            ]
          }
        },
        {
          "show": "packet"
        },
        {
          "move": {
            "el": "packet",
            "path": [
              [
                660,
                202
              ],
              [
                608,
                250
              ],
              [
                558,
                288
              ],
              [
                432,
                288
              ]
            ]
          }
        },
        {
          "show": "log-ghost2"
        },
        {
          "text": {
            "el": "ph-status",
            "value": "still waiting…"
          }
        },
        {
          "state": {
            "el": "ph-status",
            "value": "warn"
          }
        },
        {
          "state": {
            "el": "ph-browser",
            "value": "active"
          }
        }
      ]
    }
  ]
}
