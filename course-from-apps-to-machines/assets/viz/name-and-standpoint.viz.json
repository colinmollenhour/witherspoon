  "phases": [
    {
      "id": "stand",
      "title": "Ask where you stand",
      "ms": 2400,
      "narration": "`pwd` prints one line. The shell is standing in `/home/you/projects/first-site` — and every name you type without a leading `/` is measured from there.",
      "actions": [
        {
          "state": {
            "el": "sh-box",
            "value": "active"
          }
        }
      ]
    },
    {
      "id": "half-an-address",
      "title": "A relative name is half an address",
      "ms": 2800,
      "narration": "You type `cat index.html`. There is no leading `/`, so that name is not a place on its own. It is measured from the folder the shell is standing in.",
      "actions": [
        {
          "state": {
            "el": "sh-box",
            "value": ""
          }
        },
        {
          "text": {
            "el": "cmd-text",
            "value": "$ cat index.html"
          }
        },
        {
          "show": "typed"
        },
        {
          "show": "w-derive"
        },
        {
          "show": "slot-from"
        },
        {
          "show": "from-val"
        },
        {
          "show": "plus"
        },
        {
          "show": "slot-name"
        },
        {
          "move": {
            "el": "typed",
            "path": [[494, 136], [468, 172], [420, 216]]
          }
        }
      ]
    },
    {
      "id": "hit",
      "title": "The lookup lands on the file",
      "ms": 2800,
      "narration": "Measured from `/home/you/projects/first-site`, the name resolves to `/home/you/projects/first-site/index.html`. A file has that path, so `cat` prints the line you saved.",
      "actions": [
        {
          "show": "w-lookup"
        },
        {
          "show": "look-cap"
        },
        {
          "show": "look-box"
        },
        {
          "show": "look-val"
        },
        {
          "state": {
            "el": "look-box",
            "value": "ok"
          }
        },
        {
          "show": "v-ok"
        },
        {
          "show": "ev1"
        }
      ]
    },
    {
      "id": "cd-up",
      "title": "`cd ..` moves the shell, not the file",
      "ms": 2800,
      "narration": "`..` is the parent. The shell now stands in `/home/you/projects`. Read the top band again — nothing on disk moved when you typed that.",
      "actions": [
        {
          "text": {
            "el": "cmd-text",
            "value": "$ cd .."
          }
        },
        {
          "hide": "typed"
        },
        {
          "hide": "v-ok"
        },
        {
          "hide": "look-val"
        },
        {
          "hide": "look-cap"
        },
        {
          "hide": "look-box"
        },
        {
          "hide": "w-lookup"
        },
        {
          "text": {
            "el": "sh-cwd",
            "value": "/home/you/projects"
          }
        },
        {
          "text": {
            "el": "from-val",
            "value": "/home/you/projects"
          }
        },
        {
          "state": {
            "el": "sh-box",
            "value": "active"
          }
        },
        {
          "state": {
            "el": "disk-box",
            "value": "active"
          }
        }
      ]
    },
    {
      "id": "same-characters",
      "title": "The same characters, a new standpoint",
      "ms": 2800,
      "narration": "You type the same `cat index.html`. The characters are identical. The folder they are measured from is not.",
      "actions": [
        {
          "state": {
            "el": "sh-box",
            "value": ""
          }
        },
        {
          "state": {
            "el": "disk-box",
            "value": ""
          }
        },
        {
          "text": {
            "el": "cmd-text",
            "value": "$ cat index.html"
          }
        },
        {
          "jump": {
            "el": "typed",
            "to": [494, 136]
          }
        },
        {
          "show": "typed"
        },
        {
          "move": {
            "el": "typed",
            "path": [[494, 136], [468, 172], [420, 216]]
          }
        }
      ]
    },
    {
      "id": "miss",
      "title": "The lookup lands on nothing",
      "ms": 3000,
      "narration": "Measured from `/home/you/projects`, the same name resolves to `/home/you/projects/index.html`. No file has that path. The reply is `No such file or directory`.",
      "actions": [
        {
          "text": {
            "el": "look-val",
            "value": "/home/you/projects/index.html"
          }
        },
        {
          "show": "w-lookup"
        },
        {
          "show": "look-cap"
        },
        {
          "show": "look-box"
        },
        {
          "show": "look-val"
        },
        {
          "state": {
            "el": "look-box",
            "value": "bad"
          }
        },
        {
          "show": "v-bad"
        },
        {
          "show": "ev2"
        }
      ]
    },
    {
      "id": "never-moved",
      "title": "The file never moved",
      "ms": 3400,
      "narration": "One name, two standpoints, two different paths. `index.html` is still in `first-site`, where it has been all along — the lookup missed, the bytes did not. Run `pwd` before you decide a file is gone.",
      "actions": [
        {
          "state": {
            "el": "disk-box",
            "value": "ok"
          }
        },
        {
          "text": {
            "el": "disk-holds",
            "value": "still holds   <h1>Ground Zero</h1>   — unchanged"
          }
        }
      ]
    }
  ]
}
