{
  "name": "witherspoon-course-template",
  "version": "1.2.0",
  "type": "module",
  "description": "Shared Astro template that builds a self-contained static site from any approved course directory.",
  "keywords": [
    "witherspoon",
    "course",
    "curriculum",
    "static-site",
    "astro",
    "e-learning"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinmollenhour/witherspoon.git",
    "directory": "course-template"
  },
  "homepage": "https://github.com/colinmollenhour/witherspoon#readme",
  "bin": {
    "witherspoon-course": "tools/cli.mjs",
    "witherspoon-course-template": "tools/cli.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "files": [
    "src",
    "tools",
    "astro.config.mjs",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --dev",
    "verify": "node tools/verify.mjs",
    "check-widgets": "node tools/check-widgets.mjs",
    "render-views": "node tools/render-views.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-runtime.mjs",
    "test:tools": "node --test tools/dev-listen.test.mjs tools/publish.test.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "esbuild": "^0.25.10",
    "jsdom": "^29.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
