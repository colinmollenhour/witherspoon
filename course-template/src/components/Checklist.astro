---
import Markdown from './Markdown.astro';

interface Props {
  id: string;
  steps: Array<{ title: string; description: string; completionCriteria: string }>;
}

const { id, steps } = Astro.props;
---

<ul class="checklist" data-checklist={id}>
  {
    steps.map((s, i) => (
      <li>
        <input type="checkbox" id={`step-${id}-${i}`} />
        <label for={`step-${id}-${i}`}>
          {/* Every one of these is author-written prose carrying inline code —
              `completionCriteria` is a filename or a command in almost every step.
              Rendered as plain text they ship visible backticks. */}
          <strong><Markdown text={s.title} inline /></strong>
          <Markdown text={s.description} />
          <span class="criteria">You are done when: <Markdown text={s.completionCriteria} inline /></span>
        </label>
      </li>
    ))
  }
</ul>
