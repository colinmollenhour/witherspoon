---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ProgressRing from '../components/ProgressRing.astro';
import Markdown from '../components/Markdown.astro';
import { unitAccents } from '../lib/color';

const c = (await getCollection('course'))[0]!;
const units = (await getCollection('units')).sort((a, b) => a.data.index - b.data.index);

const totalQuizzes = c.data.totalQuizzes;
const aboutParagraphs = c.data.about.split(/\n{2,}/).filter(Boolean);
const palette = unitAccents(c.data.accent, units.length);
---

<Page title="Home" description={c.data.subtitle} depth={0} pagePath="index.html">
  <section class="hero">
    <p class="hero__eyebrow">{c.data.categories[0] ?? 'Course'}</p>
    <h1>{c.data.title}</h1>
    <p class="lede">
      <Markdown text={c.data.subtitle} inline />
    </p>
    <ul class="chips">
      <li class="chip"><b>{units.length}</b> <span>units</span></li>
      <li class="chip"><b>{c.data.totalTopics}</b> <span>topics</span></li>
      <li class="chip"><b>{totalQuizzes}</b> <span>quizzes and tests</span></li>
    </ul>
  </section>

  {/* Shown only once progress exists — the most valuable element for a returning learner. */}
  <a class="card card--link resume" data-resume hidden href="index.html" style="margin:1.5rem 0">
    <span>
      <strong>Resume where you left off</strong>
      <small>Pick up at the last page you opened</small>
    </span>
    <span class="resume__go" aria-hidden="true">→</span>
  </a>

  <section class="card dash" style="margin:1.5rem 0">
    <ProgressRing />
    <div class="statgrid">
      <div>
        <p class="stat" data-stat="topics">0 / {c.data.totalTopics}</p>
        <p>Topics read</p>
      </div>
      <div>
        <p class="stat" data-stat="quizzes">0</p>
        <p>Quizzes taken</p>
      </div>
      <div>
        <p class="stat" data-stat="quiz-avg">—</p>
        <p>Quiz average</p>
      </div>
      <div>
        <p class="stat" data-stat="test-avg">—</p>
        <p>Unit-test average</p>
      </div>
    </div>
  </section>

  <noscript>
    <p class="card">
      JavaScript is off, so progress tracking, grading and search are unavailable. Every reading,
      flashcard and quiz answer is still on the page.
    </p>
  </noscript>

  <section>
    <h2>About this course</h2>
    <div class="reading">
      {aboutParagraphs.map((p) => <Markdown text={p} />)}
    </div>
  </section>

  {
    c.data.spine && (
      <section class="callout" style="margin:1.5rem 0">
        <h2 class="callout__title">Where you start, and where you finish</h2>
        <p>
          <strong>Before:</strong> <Markdown text={c.data.spine.transformation.before} inline />
        </p>
        <p>
          <strong>After:</strong> <Markdown text={c.data.spine.transformation.after} inline />
        </p>
      </section>
    )
  }

  {
    c.data.skills.length > 0 && (
      <section>
        <h2>What you'll be able to do</h2>
        <div class="grid">
          {c.data.skills.map((s) => (
            <div class="card card--link">
              <h3 style="margin-top:0">{s.title}</h3>
              <p class="muted">
                <Markdown text={s.description} inline />
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section>
    <h2>Syllabus</h2>
    <div class="stack">
      {
        units.map((u) => (
          // Scoping --accent here is what gives each unit card its own colour;
          // the numeral, the edge and the progress bar inside all inherit it.
          <div class="card card--link unit-card" style={`--accent: ${palette[u.data.index - 1]}`}>
            <div class="unit-card__head">
              <span class="unit-card__n" aria-hidden="true">
                {u.data.index}
              </span>
              <div style="min-width:0">
                <h3>
                  <a href={`${u.data.slug}/index.html`}>Unit {u.data.index} — {u.data.title}</a>
                </h3>
                <p class="unit-card__desc">
                  <Markdown text={u.data.description} inline />
                </p>
              </div>
            </div>

            <div class="unit-card__meta">
              <div class="bar" data-unit-bar={u.data.unitId} style="flex:1">
                <span style="width:0%" />
              </div>
              <span>{u.data.topics.length} topics</span>
            </div>

            <div style="margin-top:.5rem">
              {u.data.topics.map((t) => (
                <div class="topic-row" data-topic-state={t.id}>
                  <span class="dot" />
                  <a href={`${u.data.slug}/${t.slug}.html`}>{t.title}</a>
                  <span class="score" />
                </div>
              ))}
            </div>

            <p class="unit-card__links">
              {u.data.test && (
                <a class="tag" href={`${u.data.slug}/test.html`}>
                  Unit test
                </a>
              )}
              {u.data.projects.map((p) => (
                <a class="tag" href={`${u.data.slug}/${p.slug}.html`}>
                  {p.title}
                </a>
              ))}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {
    c.data.faqs.length > 0 && (
      <section>
        <h2>Questions</h2>
        {c.data.faqs.map((f) => (
          <details class="card" style="margin:.5rem 0">
            <summary>{f.question}</summary>
            <Markdown text={f.answer} />
          </details>
        ))}
      </section>
    )
  }
</Page>
